 *
 * Board overlay for Conexio Stratus Pro (nRF9151, Non-Secure).
 *
 * Adds the LIS2DH accelerometer and 24CW160 EEPROM as child nodes of i2c2.
 * i2c2 is already enabled in the board DTSI (status = "okay") with pinctrl
 * and clock-frequency configured (SDA=P0.08, SCL=P0.07, 400 kHz).
 *
 * These nodes are required by I2C_DT_SPEC_GET(DT_NODELABEL(...)) in main.c.
 */

&i2c2 {
	lis2dh: lis2dh@18 {
		compatible = "st,lis2dh";
		reg = <0x18>;
		irq-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
	};

	eeprom0: eeprom@50 {
		/* Microchip 24CW160 — 2 KiB (16 kbit) EEPROM */
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <DT_SIZE_K(2)>;
		pagesize = <32>;
		address-width = <16>;
		timeout = <5>;
	};
};
